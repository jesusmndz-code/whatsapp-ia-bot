PORT=3000
NODE_ENV=development

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API)
# Mientras WHATSAPP_TOKEN esté vacío, el bot funciona en modo simulación (solo imprime en consola).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN="elige-una-clave-secreta"
WHATSAPP_API_VERSION=v23.0

# Anthropic (Claude) — pega tu clave de https://console.anthropic.com
# Responde los mensajes libres. Sin clave, el bot funciona solo con el menú.
# Es un cobro aparte del plan Pro de Claude (se paga por uso en la consola).
ANTHROPIC_API_KEY=
# Haiku es el más económico; para respuestas más elaboradas usa claude-sonnet-5-5.
CLAUDE_MODEL=claude-haiku-5-5

# Groq (transcripción de notas de voz) — crea tu clave en https://console.groq.com/keys
# Sin clave, el bot pide al cliente que escriba en texto.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# WhatsApp de la asesora (código de país, sin +): recibe un aviso por cada pedido o cliente interesado.
# Sin número, los avisos solo quedan en el log.
ASESORA_TELEFONO=
